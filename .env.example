# lixe Partner-Kit – Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Beide Schlüssel bekommst du von lixe (CMS → Plattform-Partner → Integration).

# lixe-Basisadresse (normalerweise unverändert lassen).
LIXE_APP_URL=https://app.lixe.de

# ÖFFENTLICHER Einbett-Schlüssel (beginnt mit "emb_").
# Darf im Browser stehen. Wird für Variante A UND B gebraucht.
LIXE_EMBED_KEY=emb_dein_einbett_schluessel

# GEHEIMER Schlüssel – NUR für Variante B (SSO).
# Niemals in den Browser, niemals committen. Bleibt auf deinem Server.
LIXE_SECRET_KEY=dein_geheimer_schluessel
